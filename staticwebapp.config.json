  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/css/*",
      "/js/*",
      "/trademark-registration/*",
      "/trademark-search/meta/*",
      "/trademark-search/img/*",
      "/trademark-classes/*",
      "/private-limited-company-registration/*",
      "/gst-registration/*",
      "/company-registration/*",
      "/lp/*"
    ]
  }
}
